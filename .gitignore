# 원본 RAG 자료 - 로컬 수집용
data/raw/

# Secrets
.env

# Python
.venv/
.venv-ragas/
__pycache__/
*.pyc
.pytest_cache/

# Claude Code local session state (도구/세션 로컬 상태, 프로젝트 소스 아님)
.claude/

# Local vector index / trace / cache
.cache/
logs/

# Evaluation outputs (재현 가능하므로 커밋하지 않음)
# evaluation/runs/<run_id>/ 는 24.1장에 따라 영구 보존 대상이지만, 이는
# "삭제/덮어쓰기 금지"를 의미할 뿐 Git 추적 대상이라는 뜻은 아니다 — 각 Run은
# 실제 답변 전문/RAG Context 등 부피가 큰 산출물을 담으므로 results/와 동일하게
# 로컬 파일시스템에 보존하고 Git에는 커밋하지 않는다.
evaluation/results/
evaluation/runs/
